{
  "schema_version": 1,
  "untagged_grace_days": 7,
  "channel_revision_limit": 10,
  "rollback_revision_limit": 10,
  "exception_max_days": 90,
  "stable_tag_pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+].*)?$",
  "stable_channels": ["latest"],
  "packages": [
    "rustnzbd", "indexarr-rs", "rusttorrent", "egressy", "egressy-external-probe", "ngms", "aidevenv",
    "rdpapp-gateway", "rdpapp-web", "ausfarms-api", "ausfarms-web", "paddockmuster-site", "vogt", "vogt-stack",
    "vogt-base/node", "vogt-base/python", "vogt-base/rust", "vogt-base/ubuntu", "vogt-pod-base", "vogt-demo"
  ],
  "paired_packages": [
    ["egressy", "egressy-external-probe"],
    ["rdpapp-gateway", "rdpapp-web"],
    ["ausfarms-api", "ausfarms-web"]
  ]
}
